    {
      "id": "ctr_001",
      "group": "contract",
      "endpoint": "/api/v1/contracts/review",
      "role": "lawyer",
      "input": {
        "contract_text": "劳动合同书\n甲方：某科技有限公司  乙方：张某\n第一条 合同期限：自2026年1月1日起至2026年12月31日止。\n第二条 试用期：试用期六个月，试用期工资为转正工资的60%。\n第三条 竞业限制：乙方离职后五年内不得从事同行业工作，甲方无需支付任何补偿。\n第四条 违约金：乙方提前离职须支付违约金十万元。\n第五条 工作时间：每周六天、每日十小时，不另计加班费。\n第六条 社会保险：按最低基数缴纳。",
        "contract_title": "高风险劳动合同"
      },
      "expect": {
        "risk_level_any": ["high"],
        "min_risk_points": 4,
        "must_include": ["试用期"]
      }
    },
    {
      "id": "ctr_002",
      "group": "contract",
      "endpoint": "/api/v1/contracts/review",
      "role": "lawyer",
      "input": {
        "contract_text": "劳动合同书\n甲方：某贸易有限公司  乙方：李某\n第一条 合同期限：2026年1月1日至2028年12月31日，试用期三个月。\n第二条 工作地点：杭州市西湖区。\n第三条 工作时间：标准工时制，每日八小时、每周四十小时。\n第四条 劳动报酬：月工资12000元，每月15日前发放。\n第五条 社会保险：按国家规定缴纳。\n第六条 合同解除：按劳动合同法规定执行。",
        "contract_title": "标准劳动合同"
      },
      "expect": {
        "risk_level_any": ["low", "medium"]
      }
    },
