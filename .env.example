# ===== LawAgent 智能法律咨询 Agent 系统 环境配置 =====
# 复制为 .env 后按需修改；不配置任何变量时以「纯规则 + Mock LLM + 本地数据」模式运行，
# 功能链路完整可演示（面试/离线场景友好）。

# --- 通义千问（DashScope OpenAI 兼容模式）---
# 不配置或 LLM_MOCK=1 时，所有 LLM 工具自动降级为确定性 Mock 实现
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_FALLBACK_MODEL=qwen-turbo
LLM_MOCK=0

# --- 数据库（生产 PostgreSQL；不配置则用 SQLite data/lawagent.db）---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lawagent
DB_USER=postgres
DB_PASSWORD=postgres
USE_SQLITE=1
# SQLITE_PATH=/data/lawagent.db          # 留空 = data/lawagent.db
# CHECKPOINTER_BACKEND=memory            # memory | sqlite | postgres
# CHECKPOINTER_PATH=                     # sqlite 模式的库文件路径

# --- 运行环境 / JWT ---
# APP_ENV=prod 时若未配置 JWT_SECRET 会拒绝启动（防止用默认密钥签发令牌）
APP_ENV=dev
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 留空 = 开发态随机生成一把并告警（重启后所有令牌失效）
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# --- 服务端口 ---
API_PORT=9089

# --- 演示账号种子（首次启动自动创建 lawyer/partner/legal 三个演示工号）---
SEED_DEMO_USERS=1
# 演示账号密码：源码里不写死；留空则首次启动随机生成并在日志打印一次
# （docker：docker compose logs backend | grep 随机密码）
DEMO_PASSWORD=

# --- 阶段2 限流阈值（<=0 表示该维度不限流；压测时放宽）---
# LOGIN_MAX_FAILURES_PER_MIN=5
# AUTH_IP_MAX_PER_MIN=30
# CHAT_MAX_PER_MIN=10
# 前置 nginx / 云负载均衡时置 1：改从 X-Forwarded-For 取真实客户端 IP 做限流。
# 裸奔（客户端直连后端）时保持 0，否则伪造该头即可绕过限流。
TRUST_PROXY=0

# --- 阶段3 数据接真：工商信息（mock | qcc | tianyancha）---
# 不配 key 时自动回落 mock，健康检查 /api/health 的 data_sources 会标明实际生效来源
ENTERPRISE_DATA_SOURCE=mock
ENTERPRISE_API_TIMEOUT=5
# QCC_API_KEY=
# QCC_SECRET_KEY=
# QCC_BASE_URL=https://api.qichacha.com
# TYC_API_KEY=
# TYC_BASE_URL=https://open.api.tianyancha.com

# --- 阶段3 数据接真：判例库（local | api）---
# local = 仓库内置 66 条真实案号判例；api 需给 PRECEDENT_API_URL，失败自动回落 local
PRECEDENT_DATA_SOURCE=local
# PRECEDENT_API_URL=https://your-precedent-api/search
# PRECEDENT_API_KEY=

# --- 阶段4 运维：Prometheus 指标 ---
METRICS_ENABLED=1
# METRICS_TOKEN=change-me                # 填了则 /metrics 需 Authorization: Bearer <token>
